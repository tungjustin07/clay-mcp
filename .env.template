# SFDC credentials — legacy fallback for single-profile setups.
# Preferred: add sf_username / sf_password / sf_security_token
# directly to your profile in ~/.clay-mcp/profiles.json so each
# client has its own isolated credentials.
#
# These env vars are only used if no sf_username is found in profiles.json.
SF_USERNAME=your.email@example.com
SF_PASSWORD=yourpassword
SF_SECURITY_TOKEN=yourtoken
